# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_URL=https://yourhour.lol
SITE_NAME=yourhour

# ---------------------------------------------------------------------------
# Database (auto-populated by the Neon Marketplace integration)
#   vercel integration add neon && vercel env pull
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Board pricing (cents). Spec section 3.
#   Any sale: P = P x 1.20, once per purchase however many hours it covers.
#   Silence:  the first three consecutive silent clock hours are free; the fourth
#             and each one after it takes P x 0.95.
#   Ratchet:  P can never fall below half of the highest it has ever been. That high
#             lives in board.all_time_high_floor and only ever rises.
# P is the MINIMUM an hour can be bought for, not the price -- buyers may pay more, and
# paying more buys rank on The Wall rather than a bigger move of the floor.
# Every move rounds to the nearest CENT, so the mechanic stays visible at $1.
# PRICE_FLOOR is the opening floor, underneath the ratchet.
# Start and floor are equal, so the board sits on its floor until the first sale.
# ---------------------------------------------------------------------------
BOARD_START_PRICE=100
PRICE_FLOOR=100
BOARD_START_DATE=2026-08-22
RESERVATION_MINUTES=10
CALENDAR_HOURS=24

# ---------------------------------------------------------------------------
# Cron. Any HTTP pinger (cron-job.org, QStash, Vercel cron) may call:
#   GET /api/cron/tick   with   Authorization: Bearer $CRON_SECRET
# Recommended interval: every 5 minutes.
# ---------------------------------------------------------------------------
# Shared secret for /api/cron/tick. Vercel crons do NOT drive this project (Hobby
# allows 2/day); an external pinger hits the endpoint hourly. See README.
CRON_SECRET=

# Salt for hashing visitor IPs before storing them for click dedupe.
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# Payments — Lemon Squeezy (Merchant of Record).
# Create ONE product/variant. Both products -- an hour (or a block of hours) and a
# permanent Wall spot -- go through it, with the amount passed per checkout as
# custom_price and the product told apart by `kind` in the checkout metadata.
# Leave blank locally to use the dev checkout stub at /api/dev/complete.
# ---------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email — Resend (auto-populated by the Marketplace integration)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="yourhour <hello@yourhour.lol>"

# ---------------------------------------------------------------------------
# Analytics — Vemetric
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VEMETRIC_TOKEN=
VEMETRIC_TOKEN=
VEMETRIC_PUBLIC_DASHBOARD_URL=

# ---------------------------------------------------------------------------
# X announcements.
# X removed the free tier for new developers in Feb 2026. Pay-per-use:
#   post WITHOUT a link  $0.015
#   post WITH a link     $0.200   <-- the announcement includes a link
# At a full 24-slot day that is ~$4.80/day. X_DAILY_POST_CAP is a hard,
# database-backed ceiling; X_ANNOUNCE_ENABLED=false is the kill switch.
# ---------------------------------------------------------------------------
X_ANNOUNCE_ENABLED=false
X_DAILY_POST_CAP=24
# The account announcements come from. Named to the buyer in the 30-minute reminder.
X_HANDLE=@shahzod1001
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
