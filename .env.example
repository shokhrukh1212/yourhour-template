# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_URL=https://yourhour.lol
SITE_NAME=yourhour

# ---------------------------------------------------------------------------
# Database (auto-populated by the Neon Marketplace integration)
#   vercel integration add neon && vercel env pull
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# There is NO pricing configuration.
#
# A spot on The Wall costs a hardcoded $3 minimum, and rank #1 costs $1 more than
# the highest amount anyone has paid. Both live in lib/pricing.ts, deliberately as
# constants rather than env vars: the price is a promise to buyers, and a promise
# that can be edited in a dashboard is not one.
# ---------------------------------------------------------------------------
RESERVATION_MINUTES=10
CALENDAR_HOURS=24

# ---------------------------------------------------------------------------
# Cron. Any HTTP pinger (cron-job.org, QStash, Vercel cron) may call:
#   GET /api/cron/tick   with   Authorization: Bearer $CRON_SECRET
#
# Hourly is plenty. It only closes elapsed hours and keeps the 24-hour calendar
# populated -- the same work every page render already does -- so it matters only on
# a day with no visitors. Vercel Hobby crons run once a day and cannot drive this.
# ---------------------------------------------------------------------------
CRON_SECRET=

# Salt for hashing visitor IPs before storing them for click dedupe.
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# Payments — Lemon Squeezy (Merchant of Record).
# ONE product/variant. The amount is passed per checkout as custom_price, and Lemon
# Squeezy collects the buyer's email and sends the receipt -- we never ask for it.
# Leave blank locally to use the dev checkout stub at /api/dev/complete.
# ---------------------------------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Analytics — Vemetric
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VEMETRIC_TOKEN=
VEMETRIC_TOKEN=
VEMETRIC_PUBLIC_DASHBOARD_URL=
